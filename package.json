{
  "name": "@majikmate/ts-utils",
  "version": "1.1.0",
  "description": "Small helpers for the majikmate TypeScript courses: prompt(), the command ts (check, then run with Node.js) and a clean terminal for F5",
  "license": "MIT",
  "type": "module",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/majikmate/ts-utils.git"
  },
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./register": "./dist/register.js",
    "./debug-terminal": "./dist/debug-terminal.js"
  },
  "bin": {
    "ts": "dist/ts.js"
  },
  "files": [
    "dist",
    "src"
  ],
  "engines": {
    "node": ">=22.15"
  },
  "peerDependencies": {
    "typescript": ">=5.0"
  },
  "peerDependenciesMeta": {
    "typescript": {
      "optional": true
    }
  },
  "scripts": {
    "build": "tsc",
    "test": "node --test test/*.test.ts"
  },
  "devDependencies": {
    "@types/node": "^26.0.0",
    "typescript": "6.0.3"
  }
}
